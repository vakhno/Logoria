# Backend
API_PORT=3000
API_PUBLIC_URL=https://your-production-backend.example
APP_PUBLIC_URL=https://your-production-frontend.example
DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION-DATABASE-HOST/DATABASE_NAME?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=https://your-production-backend.example
BETTER_AUTH_TRUSTED_ORIGINS=https://your-production-frontend.example,https://your-production-backend.example
VITE_APP_PUBLIC_URL=https://your-production-vite-frontend.example
VITE_API_PUBLIC_URL=https://your-production-backend.example
GOOGLE_AUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_AUTH_CLIENT_SECRET=replace-with-google-client-secret

# Frontend
APP_URL=https://your-production-frontend.example
NEXT_PUBLIC_API_URL=https://your-production-backend.example
NEXT_PUBLIC_APP_URL=https://your-production-frontend.example

# Docker Compose
ENV_FILE=.env.production
NODE_IMAGE=node:22-alpine
APP_PORT_NEXT=3001
APP_PORT_VITE=3003
BACKEND_BUILD_CONTEXT=.
BACKEND_DOCKERFILE=apps/backend/Dockerfile
BACKEND_EXPOSE_PORT=3000
BACKEND_HOST_PORT=3002
BACKEND_CONTAINER_PORT=3000
FRONTEND_BUILD_CONTEXT=.
FRONTEND_DOCKERFILE=apps/frontend-next/Dockerfile
BACKEND_CONTAINER_COMMAND=pnpm --filter backend run start
FRONTEND_CONTAINER_COMMAND=pnpm --filter frontend-next run start
