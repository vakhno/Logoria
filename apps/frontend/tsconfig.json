{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@shared/components": ["../../shared/components/src/index.ts"],
      "@shared/components/*": ["../../shared/components/src/*"],
      "@shared/i18n": ["../../shared/i18n/src/index.ts"],
      "@shared/i18n/*": ["../../shared/i18n/src/*"],
      "@shared/routes": ["../../shared/routes/src/index.ts"],
      "@shared/queries": ["../../shared/queries/src/index.ts"],
      "@shared/queries/*": ["../../shared/queries/src/*"],
      "@shared/theme": ["../../shared/theme/src/index.ts"],
      "@shared/theme/*": ["../../shared/theme/src/*"]
    },
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
