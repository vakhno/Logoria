{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "pnpm --filter @shared/routes run build && pnpm --filter @shared/i18n run build && pnpm --filter @shared/components run build && pnpm --filter @shared/auth run build && pnpm --filter @shared/schemas run build && pnpm --filter @shared/queries run build && next build",
    "start": "next start -p 3001"
  },
  "dependencies": {
    "@shared/auth": "workspace:*",
    "@shared/components": "workspace:*",
    "@shared/i18n": "workspace:*",
    "@shared/queries": "workspace:*",
    "@shared/routes": "workspace:*",
    "@shared/styles": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "^1.7.2",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  }
}
