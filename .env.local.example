API_PORT=3002
APP_PORT=3001
API_PUBLIC_URL=https://localhost:3002
APP_PUBLIC_URL=https://localhost:3001
INTERNAL_API_URL=http://localhost:3002

# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_name
BETTER_AUTH_SECRET=replace-with-a-random-secret
GOOGLE_AUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_AUTH_CLIENT_SECRET=replace-with-google-client-secret

# Docker Compose
ENV_FILE=.env.local
NODE_IMAGE=node:22-alpine
POSTGRES_IMAGE=postgres:17
POSTGRES_DB=app_name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
POSTGRES_CONTAINER_PORT=5432
POSTGRES_DATA_PATH=/var/lib/postgresql/data
PG_DATA_VOLUME=pg-data
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
DOCKER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app_name
BACKEND_BUILD_CONTEXT=.
BACKEND_DOCKERFILE=apps/backend/Dockerfile
BACKEND_DEV_COMMAND=pnpm --filter backend run dev
FRONTEND_BUILD_CONTEXT=.
FRONTEND_DOCKERFILE=apps/frontend/Dockerfile
FRONTEND_DEV_COMMAND=pnpm --filter frontend run dev
